# Copy to .env and fill in values.

# Web backend URL.
# Local web dev: http://localhost:3000 (works only on iOS sim / web).
# Real device: replace with your machine LAN IP, e.g. http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Cloudinary cloud name (for direct uploads — same value as web NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
